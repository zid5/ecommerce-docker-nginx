<header class="site-header">
	<a class="brand" href="/" aria-label="Field and Form home">
		<span class="brand-mark">F.</span>
		<span>field <span class="brand-amp">&</span> form</span>
	</a>
	<nav class="site-nav" aria-label="Main navigation">
		<a class="header-link" href="/#products">Shop the collection <span aria-hidden="true">↘</span></a>
		<% if (currentUser) { %>
			<% if (currentUser.role === 'admin') { %><a class="header-link" href="/admin">Admin</a><% } %>
			<form class="logout-form">
				<input type="hidden" name="csrfToken" value="<%= csrfToken %>">
				<button class="nav-button" type="submit">Sign out</button>
			</form>
		<% } else { %>
			<a class="header-link" href="/login">Sign in</a>
			<a class="nav-signup" href="/signup">Create account</a>
		<% } %>
	</nav>
</header>
